# Las claves NO llevan prefijo VITE_ para que no lleguen al renderer; solo las lee el proceso main.
AI_PROVIDER=ollama
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
BRAVE_SEARCH_API_KEY=
PIPER_BIN=piper
PIPER_MODEL=voices/es_ES-davefx-medium.onnx
WHISPER_MODEL=base
MIC_DEVICE=

# Avisos al móvil (ntfy). Usa un tema propio y difícil de adivinar; ntfy.sh es público.
# Puedes configurarlo desde el asistente inicial. Déjalo vacío para desactivarlo.
NTFY_TOPIC=
NTFY_AUTO=false
# WhatsApp: app (whatsapp://) o web (wa.me)
WHATSAPP_MODE=app
# Modo Discord (audio del sistema): umbral de volumen para detectar voz
LOOPBACK_THRESHOLD=0.01

# Control del PC (buscar archivos, redactar .txt...). on | off
PC_CONTROL=on
